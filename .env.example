# ---------- BACKEND (copy this file to ".env" in this folder or in backend/) ----------

# REQUIRED: a long random string used to sign login tokens (16+ chars).
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_SECRET=change-me-to-a-long-random-string

# Where the SQLite database, trained models and uploaded CSVs are stored.
# Locally you can leave these out (defaults are inside the backend/ folder).
# On Render with a persistent disk mounted at /var/data, use:
#   DATABASE_PATH=/var/data/app.db
#   MODEL_DIR=/var/data/ml_models
#   UPLOAD_DIR=/var/data/uploads
DATABASE_PATH=./app.db
MODEL_DIR=./ml_models
UPLOAD_DIR=./uploads

# Frontend URLs allowed to call the API (comma separated, no trailing slash).
CORS_ORIGINS=http://localhost:5173

# OPTIONAL: creates the admin account automatically on startup if none exists.
# Handy on hosts without a shell. Remove the password from the dashboard afterwards if you like.
# Locally you can instead run:  python create_admin.py   (or use the first-time setup screen)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ---------- FRONTEND (set in frontend/.env.local or in the Vercel dashboard) ----------
# Backend API URL. Leave empty for local development.
# Example on Vercel: VITE_API_URL=https://your-backend.onrender.com
VITE_API_URL=
